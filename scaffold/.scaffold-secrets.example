# .scaffold-secrets.example
# Copy this to .scaffold-secrets, fill in real values, NEVER commit .scaffold-secrets

# ── Vercel ────────────────────────────────────────────────────────────────────
# vercel.com/account/tokens → Create Token (full account access)
# Used by scaffold.js instead of Vercel CLI (cross-platform, no install required)
VERCEL_TOKEN=REPLACE_ME

# ── Spaceship ─────────────────────────────────────────────────────────────────
# spaceship.com/application/api-manager/ → create key with scopes:
#   domains:write       (NS changes)
#   dnsrecords:write    (add/update/delete DNS records)
#   dnsrecords:read     (read DNS records)
SPACESHIP_PUBLISHABLE_KEY=REPLACE_ME
SPACESHIP_SECRET_KEY=REPLACE_ME

# ── Turso ─────────────────────────────────────────────────────────────────────
# app.turso.tech → Settings → API Tokens → Create new token
TURSO_API_TOKEN=REPLACE_ME
# app.turso.tech → your org slug in the URL (e.g. app.turso.tech/YOUR_ORG_SLUG)
TURSO_ORG=REPLACE_ME

# ── OpenRouter ─────────────────────────────────────────────────────────────────
# Create ONE "Provisioning" key at openrouter.ai/settings/keys
# This key creates all your per-project keys automatically
OPENROUTER_PROVISIONING_KEY=sk-or-v1-REPLACE_ME

# ── Pollinations ───────────────────────────────────────────────────────────────
# Create ONE "secret" key with the account:keys permission at enter.pollinations.ai/keys
# This key creates all your per-project keys automatically (POST /account/keys)
POLLINATIONS_ACCOUNT_KEY=sk_REPLACE_ME

# ── Upstash ────────────────────────────────────────────────────────────────────
# upstash.com → Account → Management API
UPSTASH_MANAGEMENT_API_KEY=REPLACE_ME
# Management API auth is HTTP Basic email:api_key, NOT a Bearer token — this
# is the email you log into console.upstash.com with
UPSTASH_ACCOUNT_EMAIL=you@example.com

# ── Upstash QStash ─────────────────────────────────────────────────────────────
# console.upstash.com/qstash → copy token + signing keys (no Management API for these)
# QSTASH_URL is region-specific: https://qstash-{region}.upstash.io
# Signing keys can also be fetched via: GET https://qstash.upstash.io/v2/keys (Bearer QSTASH_TOKEN)
QSTASH_URL=REPLACE_ME
QSTASH_TOKEN=REPLACE_ME
QSTASH_CURRENT_SIGNING_KEY=REPLACE_ME
QSTASH_NEXT_SIGNING_KEY=REPLACE_ME

# ── Resend ─────────────────────────────────────────────────────────────────────
# Your GLOBAL Resend key — script creates per-domain subkeys from this
# resend.com → API Keys
RESEND_API_KEY=re_REPLACE_ME

# ── Cloudflare ─────────────────────────────────────────────────────────────────
# dash.cloudflare.com (right sidebar when logged in)
CLOUDFLARE_ACCOUNT_ID=REPLACE_ME
# dash.cloudflare.com/{account_id}/api-tokens/create → Create Custom Token
#   Required permissions:
#     • Account & Billing → Account API Tokens → Edit   (lets scaffold create scoped tokens via API)
#     • Developer Platform → Workers R2 Storage → Edit  (lets scaffold create R2 buckets + access keys)
#   Account Resources: Include → your account
#   This is a meta-token — scaffold uses it to provision per-project R2 tokens automatically
CLOUDFLARE_API_TOKEN=REPLACE_ME

# ── Global AI keys (not per-project) ──────────────────────────────────────────
# aistudio.google.com → Get API key
GEMINI_API_KEY=AIzaREPLACE_ME
