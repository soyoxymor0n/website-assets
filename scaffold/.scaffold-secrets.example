# .scaffold-secrets.example
# Copy this to .scaffold-secrets, fill in real values, NEVER commit .scaffold-secrets

# ── Vercel ────────────────────────────────────────────────────────────────────
# vercel.com/account/tokens → Create Token (full account access)
# Used by scaffold.js instead of Vercel CLI (cross-platform, no install required)
VERCEL_TOKEN=REPLACE_ME

# ── Spaceship ─────────────────────────────────────────────────────────────────
# spaceship.com/application/api-manager/ → create key with scopes:
#   domains:write       (NS changes)
#   dnsrecords:write    (add/update/delete DNS records)
#   dnsrecords:read     (read DNS records)
SPACESHIP_PUBLISHABLE_KEY=REPLACE_ME
SPACESHIP_SECRET_KEY=REPLACE_ME

# ── OpenRouter ─────────────────────────────────────────────────────────────────
# Create ONE "Provisioning" key at openrouter.ai/settings/keys
# This key creates all your per-project keys automatically
OPENROUTER_PROVISIONING_KEY=sk-or-v1-REPLACE_ME

# ── Upstash ────────────────────────────────────────────────────────────────────
# upstash.com → Account → Management API
UPSTASH_MANAGEMENT_API_KEY=REPLACE_ME

# ── Resend ─────────────────────────────────────────────────────────────────────
# Your GLOBAL Resend key — script creates per-domain subkeys from this
# resend.com → API Keys
RESEND_API_KEY=re_REPLACE_ME

# ── Cloudflare ─────────────────────────────────────────────────────────────────
# dash.cloudflare.com (right sidebar when logged in)
CLOUDFLARE_ACCOUNT_ID=REPLACE_ME
# dash.cloudflare.com/profile/api-tokens → Create Token → Edit Cloudflare Workers template
CLOUDFLARE_API_TOKEN=REPLACE_ME

# ── Global AI keys (not per-project) ──────────────────────────────────────────
# aistudio.google.com → Get API key
GEMINI_API_KEY=AIzaREPLACE_ME
